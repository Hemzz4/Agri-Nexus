# ==============================================================================
# AGRI-INSIGHT / AGRINEXUS ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your own development or production values.
# DO NOT commit real secrets or production keys to version control.
# ==============================================================================

# Application Environment ('development' or 'production')
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 1. Google Gemini API Configuration
# ------------------------------------------------------------------------------
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
# Leave empty or provide a placeholder for offline/mock development.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. JWT Authentication Secret Key
# ------------------------------------------------------------------------------
# Used to sign and verify JSON Web Tokens (OAuth2 / User authentication).
# In production, this MUST be a cryptographically random string (min 32 characters).
# You can generate one via: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_min_32_chars

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional)
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# 4. Optional Dataset Overrides
# ------------------------------------------------------------------------------
# By default, datasets are loaded portably from 'backend/data/'.
# CLIMATE_DATASET_PATH=
# YIELD_DATASET_PATH=
# FERTILIZER_DATASET_PATH=
